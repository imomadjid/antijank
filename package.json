{
  "name": "antijank",
  "version": "0.1.0",
  "description": "Catches one-frame UI glitches coding agents can't see in screenshots: records every element's position and opacity on every frame and reports jumps, flashes, pop-ins and pushed neighbours as text.",
  "type": "module",
  "license": "MIT",
  "author": "imomadjid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imomadjid/antijank.git"
  },
  "homepage": "https://github.com/imomadjid/antijank#readme",
  "bugs": "https://github.com/imomadjid/antijank/issues",
  "keywords": [
    "animation",
    "jank",
    "layout-shift",
    "flip",
    "agent-skills",
    "playwright",
    "claude-code"
  ],
  "bin": {
    "antijank": "skills/antijank/scripts/run.mjs"
  },
  "files": [
    "skills/antijank"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "playwright": ">=1.45"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "1.65.0"
  },
  "packageManager": "pnpm@12.15.0"
}
